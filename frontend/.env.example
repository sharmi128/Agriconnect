# Copy this file to `.env` and fill in your Spring Boot backend address.
# `.env` is git-ignored, so your local address is never committed.
# Restart the dev server (`npx expo start`) after changing this file.

# Where your Spring Boot server is reachable FROM THE DEVICE:
#   Android emulator -> http://10.0.2.2:8080
#   iOS simulator    -> http://localhost:8080
#   Physical phone   -> http://<your-computer-LAN-IP>:8080
#   Web browser      -> http://localhost:8080
EXPO_PUBLIC_API_URL=http://localhost:8080
